.venv/
__pycache__/
*.pyc
# out/ is regenerable, except the four figures embedded in README.md, which
# are committed so they render on GitHub without a build step. A plain "out/"
# rule would exclude the directory itself and negation patterns can't reach
# inside an excluded directory, hence "out/*" rather than "out/" here.
out/*
!out/baruah_validation.png
!out/sweep_insertion_altitude.png
!out/sweep_ram_area.png
!out/sweep_safe_mode_timing.png
reference/
web/node_modules/
web/dist/
.DS_Store

# Reference PDFs (e.g. docs/baruah_2024.pdf) stay local: for human reference
# only, no code reads them, and redistributing a copyrighted journal article
# from a public repo isn't a call to make silently.
docs/*.pdf
